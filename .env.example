# Production application configuration
APP_URL=https://algonquianrealestate.ai.studio
ARE_API_BASE_URL=https://api.algonquianrealestate.com/v1
ARE_API_CLIENT_ID=algq-agent-engine
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
ARE_APP_ENV=production

# Server-side secrets only. Never expose these through Vite/import.meta.env,
# commit real values, or send them to the browser bundle.
ARE_API_TOKEN=<SERVER-SIDE ARE SERVICE SECRET>
OPENAI_API_KEY=<SERVER-SIDE OPENAI SECRET>
GEMINI_API_KEY=<SERVER-SIDE GEMINI SECRET>
