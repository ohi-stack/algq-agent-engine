# Gemini AI
# Keep Gemini credentials server-side. AI Studio may inject this value at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App surface
APP_URL="MY_APP_URL"
VITE_ARE_RUNTIME_SURFACE="auto"

# Canonical ARE API gateway. Browser requests use the authenticated user/session;
# do not place service secrets in VITE_* variables because they are public in the bundle.
VITE_ARE_API_URL="https://api.algonquianrealestate.com/v1"

# WordPress Platform/API Bridge fallback. When the dashboard is mounted inside
# AlgonquianRealEstate.com or wp-admin, the plugin may override this and inject
# a REST nonce through window.ARE_AGENT_ENGINE_CONFIG.
VITE_ARE_WORDPRESS_REST_URL="https://algonquianrealestate.com/wp-json/algq/v1"

# dual = API gateway first, WordPress bridge fallback.
# api = API gateway only. wordpress = WordPress bridge only. offline = demo/local only.
VITE_ARE_SYNC_MODE="dual"

# Synchronization cadence. The coordinator only writes authoritative changes
# through the ARE service contract after a live platform snapshot is resolved.
VITE_ARE_SYNC_INTERVAL_MS="15000"
VITE_ARE_MUTATION_SCAN_MS="1000"

# Remote changes refresh the mounted website/wp-admin surface when no form field
# is being edited. Set false for a kiosk/demo environment.
VITE_ARE_RELOAD_ON_REMOTE_CHANGE="true"

# Optional build/runtime labels used in correlation and health telemetry.
VITE_ARE_APP_VERSION="0.2.0"
VITE_ARE_CLIENT_ID="algq-agent-engine"
