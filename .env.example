# GEMINI_API_KEY: Optional/required depending on the configured model provider.
# Store real provider credentials in the deployment platform's protected secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this Agent Engine application build is hosted.
APP_URL="MY_APP_URL"

# Canonical Algonquian Real Estate API gateway.
ARE_API_BASE_URL="https://api.algonquianrealestate.com/v1"

# Dedicated Agent Command Console node.
ACC_PUBLIC_URL="https://acc.algonquianrealestate.com"

# Production deployments should set NODE_ENV=production.
NODE_ENV="development"
